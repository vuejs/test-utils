{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:js-lib', 'security:minimumReleaseAgeNpm'],
  // only 1 PR at the same time (to avoid cascading rebase)
  prConcurrentLimit: 1,
  // auto-merge if build is OK
  automerge: true,
  packageRules: [
    // group vitest packages update
    {
      groupName: 'vitest',
      matchPackageNames: ['@vitest/{/,}**', 'vitest{/,}**']
    },
    // group vite packages update
    {
      groupName: 'vite',
      matchPackageNames: ['@vitejs/{/,}**', 'vite{/,}**', '!vitest{/,}**']
    },
    // group all minor dependencies, once a week
    {
      matchUpdateTypes: ['minor', 'patch'],
      matchCurrentVersion: '>=1',
      groupName: 'all non-major dependencies',
      groupSlug: 'all-minor-patch',
      schedule: ['after 1am on Wednesday'],
      matchPackageNames: ['*']
    },
    // keep Playwright packages and the browser image in sync
    {
      matchDatasources: ['npm', 'docker'],
      matchPackageNames: [
        'playwright',
        '@playwright/**',
        'mcr.microsoft.com/playwright'
      ],
      groupName: 'playwright',
      groupSlug: 'playwright',
      prCreation: 'not-pending'
    },
    // wait for the npm cooldown before opening the grouped image update
    {
      matchDatasources: ['npm'],
      matchPackageNames: ['playwright', '@playwright/**'],
      minimumReleaseAge: '3 days',
      internalChecksFilter: 'none'
    }
  ]
}
